rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /team-logos/{tournamentId}/{registrationId}/{fileName} {
      // La inscripción puede hacerse desde la vista pública o autenticada.
      allow write: if request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }
  }
}
