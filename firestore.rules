rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Todas las operaciones requieren una sesión válida de Firebase Auth.
    function signedIn() {
      return request.auth != null;
    }

    // Los administradores se gestionan mediante custom claims desde un entorno seguro.
    function hasRole(role) {
      return signedIn()
        && ((request.auth.token.roles is list && role in request.auth.token.roles)
          || request.auth.token.rol == role);
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('admin_liga');
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // El catálogo de clubes se consulta para inscribir equipos; solo la liga lo administra.
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'email', 'coachName', 'coachDocument', 'coachEmail', 'assistantName', 'assistantDocument', 'assistantEmail', 'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'email', 'coachName', 'coachDocument', 'coachEmail', 'assistantName', 'assistantDocument', 'assistantEmail', 'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    function isAssignedOfficial(match) {
      return signedIn()
        && (match.get('refereeId', '') == request.auth.uid
          || match.get('refereeOne', '') == request.auth.uid
          || match.get('refereeTwo', '') == request.auth.uid
          || match.get('timekeeper', '') == request.auth.uid
          || match.get('scorer', '') == request.auth.uid
          || match.get('officialIds', []).hasAny([request.auth.uid]));
    }

    function canManageTournament(tournamentId) {
      return isAdmin()
        || (signedIn()
          && get(/databases/$(database)/documents/tournaments/$(tournamentId))
            .data.adminId == request.auth.uid);
    }

    // El usuario solo puede consultar y actualizar su propio perfil.
    match /users/{userId} {
      allow read: if isAdmin()
        || isSelf(userId)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        || (isSelf(userId)
          && request.resource.data.uid == userId
          && request.resource.data.roles is list
          && request.resource.data.roles.size() > 0
          && request.resource.data.roles.hasOnly([
            'jugador', 'entrenador', 'arbitro', 'club', 'publico'
          ]));
      allow update: if isAdmin()
        || (isSelf(userId)
          && request.resource.data.uid == userId
          && request.resource.data.roles is list
          && request.resource.data.roles.size() > 0
          && (request.resource.data.roles == resource.data.get('roles', [])
            || request.resource.data.roles.hasOnly([
              'jugador', 'entrenador', 'arbitro', 'club', 'publico'
            ])));
      allow delete: if isAdmin();
    }

    // Los perfiles de árbitros pueden consultarse para completar inscripciones.
    match /referees/{refereeId} {
      allow read: if isAdmin()
        || isSelf(refereeId)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Directorio de perfiles para reutilizar datos en inscripciones.
    match /profile_directory/{profileId} {
      allow read: if isAdmin()
        || isSelf(profileId)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSelf(profileId) || isAdmin();
      allow update: if isSelf(profileId) || isAdmin();
      allow delete: if isSelf(profileId) || isAdmin();
    }

    // Los torneos son visibles para administradores y participantes.
    match /tournaments/{tournamentId} {
      // La información de los torneos es pública; las operaciones de escritura
      // siguen restringidas al administrador de liga.
      allow read: if true;
      // Solo un administrador de liga puede crear torneos y debe quedar como dueño.
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.categories is list
        && request.resource.data.categories.size() > 0
        && request.resource.data.format in ['todos_contra_todos', 'por_grupos']
        && request.resource.data.status == 'upcoming';
      allow update: if canManageTournament(tournamentId)
        && request.resource.data.adminId == resource.data.adminId;
      allow delete: if canManageTournament(tournamentId);

      match /categories/{categoryId} {
        allow read: if true;
        allow create, update, delete: if canManageTournament(tournamentId);
      }

      match /venues/{venueId} {
        allow read: if true;
        allow create, update, delete: if canManageTournament(tournamentId);
      }

      match /registrations/{registrationId} {
        allow create: if get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.publicRegistration == true
          && request.resource.data.keys().hasOnly([
            'id', 'tournamentId', 'registrationId', 'teamName', 'clubName',
            'clubs', 'coachName', 'coachDocument', 'coachPhone', 'clubEmail',
            'category', 'uniformColor', 'logoUrl', 'players', 'playerCount',
            'status', 'createdAt', 'updatedAt', 'verificationMessage',
            'termsAccepted'
          ])
          && request.resource.data.status == 'pending'
          && request.resource.data.termsAccepted == true
          && (get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('registrationDeadline', null) == null
            || request.time <= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('registrationDeadline', null))
          && request.resource.data.teamName is string
          && request.resource.data.coachName is string
          && request.resource.data.coachName.size() > 0
          && request.resource.data.coachDocument is string
          && request.resource.data.coachDocument.size() > 0
          && request.resource.data.clubEmail is string
          && request.resource.data.clubEmail.size() > 3
          && request.resource.data.clubEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && request.resource.data.players.size() >= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('minPlayersPerTeam', 1)
          && request.resource.data.players.size() <= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('maxPlayersPerTeam', 99);
        allow read: if canManageTournament(tournamentId)
          || (signedIn()
            && resource.data.get('coachUid', '') == request.auth.uid)
          || (signedIn()
            && resource.data.get('coachEmail', '') == request.auth.token.email);
        allow update: if canManageTournament(tournamentId)
          || (signedIn()
            && resource.data.coachEmail == request.auth.token.email
            && request.resource.data.coachEmail == resource.data.coachEmail
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'teamName', 'clubName', 'clubs', 'coachName', 'coachDocument',
              'coachPhone', 'clubEmail', 'category', 'uniformColor', 'logoUrl',
              'players', 'playerCount', 'updatedAt', 'rejectionReason'
            ])
            && request.resource.data.status == 'pending'
            && request.resource.data.termsAccepted == true
            && request.resource.data.players.size() >= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('minPlayersPerTeam', 1)
            && request.resource.data.players.size() <= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('maxPlayersPerTeam', 99));
        allow delete: if canManageTournament(tournamentId);
      }

      // Resumen público sin datos de identidad, separado de la inscripción privada.
      match /public_teams/{teamId} {
        allow read: if true;
        allow create, update, delete: if canManageTournament(tournamentId);

        match /matches/{matchId} {
          allow read: if true;
          allow create, update, delete: if canManageTournament(tournamentId);
        }
      }

      // Los equipos contienen datos personales y solo los consulta su equipo administrador.
      match /teams/{teamId} {
        allow read: if canManageTournament(tournamentId)
          || (signedIn()
            && resource.data.get('coachUid', '') == request.auth.uid)
          || (signedIn()
            && resource.data.get('coachEmail', '') == request.auth.token.email);
        allow create, update: if canManageTournament(tournamentId);
        allow delete: if canManageTournament(tournamentId);
      }

      // Los partidos pertenecen al torneo y los gestiona su administrador.
      match /matches/{matchId} {
        allow read: if canManageTournament(tournamentId)
          || (signedIn() && resource.data.participantIds.hasAny([request.auth.uid]))
          || (signedIn() && (resource.data.refereeId == request.auth.uid
            || resource.data.refereeOne == request.auth.uid
            || resource.data.refereeTwo == request.auth.uid
            || resource.data.timekeeper == request.auth.uid
            || resource.data.scorer == request.auth.uid
            || resource.data.get('officialIds', []).hasAny([request.auth.uid])));
        allow create: if canManageTournament(tournamentId);
        allow update: if canManageTournament(tournamentId)
          || (isAssignedOfficial(resource.data)
            && resource.data.get('status', 'scheduled') != 'finished'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'elapsedSeconds', 'period', 'periodStartedAt',
              'startedAt', 'finishedAt', 'events', 'homeScore', 'awayScore',
              'finalHomeScore', 'finalAwayScore', 'finalPeriod',
              'finalElapsedSeconds', 'finalEvents', 'standingsUpdatedAt',
              'timeoutOwner', 'timeoutRemaining', 'lineupStatus',
              'lineupApprovedAt', 'lineupApprovedBy', 'lineupApprovedByName'
            ])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || request.resource.data.status in ['scheduled', 'paused', 'en_curso', 'tiempo_muerto', 'finished'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['homeScore'])
              || (request.resource.data.homeScore is int && request.resource.data.homeScore >= 0))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['awayScore'])
              || (request.resource.data.awayScore is int && request.resource.data.awayScore >= 0))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['events'])
              || request.resource.data.events is list)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lineupStatus'])
              || (request.resource.data.get('lineupStatus', '') == 'approved'
                && resource.data.get('lineupStatus', 'pending') != 'approved'
                && request.resource.data.get('lineupApprovedBy', '') == request.auth.uid)));
        allow delete: if canManageTournament(tournamentId);
      }
    }

    // Los partidos del calendario son públicos; las escrituras siguen sujetas
    // a las reglas específicas de cada torneo.
    match /{path=**}/matches/{matchId} {
      allow read: if true;
    }

    // Mantiene compatibilidad con la colección raíz creada en Firebase Console.
    match /teams/{teamId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
