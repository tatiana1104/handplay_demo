rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Todas las operaciones requieren una sesión válida de Firebase Auth.
    function signedIn() {
      return request.auth != null;
    }

    // Los administradores se gestionan mediante custom claims desde un entorno seguro.
    function hasRole(role) {
      return signedIn()
        && ((request.auth.token.roles is list && role in request.auth.token.roles)
          || request.auth.token.rol == role);
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('admin_liga');
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function tournamentMember(tournamentId) {
      return signedIn()
        && get(/databases/$(database)/documents/tournaments/$(tournamentId))
          .data.participantIds.hasAny([request.auth.uid]);
    }

    function canManageTournament(tournamentId) {
      return isAdmin()
        || (signedIn()
          && get(/databases/$(database)/documents/tournaments/$(tournamentId))
            .data.adminId == request.auth.uid);
    }

    // El usuario solo puede consultar y actualizar su propio perfil.
  match /users/{userId} {
    allow read: if isSelf(userId) || isAdmin() || resource.data.roles.hasAny(['arbitro']);
  allow create: if isAdmin()
  || (isSelf(userId)
    && request.resource.data.uid == userId
    && request.resource.data.rol in ['jugador', 'entrenador']
    && request.resource.data.roles is list
    && request.resource.data.roles.hasOnly(['jugador', 'entrenador']));
  allow update: if isAdmin()
  || (isSelf(userId)
    && request.resource.data.uid == resource.data.uid
    && request.resource.data.roles is list
    && request.resource.data.roles.hasAll(resource.data.roles));
      allow delete: if isAdmin();
    }

    // Los torneos son visibles para administradores y participantes.
    match /tournaments/{tournamentId} {
      // La información de los torneos es pública; las operaciones de escritura
      // siguen restringidas al administrador de liga.
      allow read: if true;
      // Solo un administrador de liga puede crear torneos y debe quedar como dueño.
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.categories is list
        && request.resource.data.categories.size() > 0
        && request.resource.data.format in ['todos_contra_todos', 'por_grupos']
        && request.resource.data.status == 'upcoming';
      allow update: if canManageTournament(tournamentId)
        && request.resource.data.adminId == resource.data.adminId;
      allow delete: if canManageTournament(tournamentId);

      match /registrations/{registrationId} {
        allow create: if get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.publicRegistration == true
          && request.resource.data.status == 'pending'
          && request.resource.data.termsAccepted == true
          && (get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.registrationDeadline == null
            || request.time <= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.registrationDeadline)
          && request.resource.data.teamName is string
          && request.resource.data.coachName is string
          && request.resource.data.coachName.size() > 0
          && request.resource.data.coachEmail is string
          && request.resource.data.coachEmail.size() > 3
          && request.resource.data.coachEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && request.resource.data.players.size() >= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.minPlayersPerTeam
          && request.resource.data.players.size() <= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.maxPlayersPerTeam;
        allow read: if canManageTournament(tournamentId)
          || resource.data.status == 'approved'
          || (signedIn()
            && resource.data.coachEmail == request.auth.token.email);
        allow update: if canManageTournament(tournamentId)
          || (signedIn()
            && resource.data.coachEmail == request.auth.token.email
            && request.resource.data.coachEmail == resource.data.coachEmail
            && request.resource.data.status == 'pending'
            && request.resource.data.termsAccepted == true
            && request.resource.data.players.size() >= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.minPlayersPerTeam
            && request.resource.data.players.size() <= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.maxPlayersPerTeam);
        allow delete: if canManageTournament(tournamentId);
      }

      // Los equipos pertenecen a un torneo y no pueden quedar accesibles de forma pública.
      match /teams/{teamId} {
        allow read: if canManageTournament(tournamentId)
          || resource.data.status == 'approved'
          || tournamentMember(tournamentId);
        allow create: if canManageTournament(tournamentId)
          || (signedIn()
            && request.resource.data.coachUid == request.auth.uid
            && request.resource.data.status == 'pending');
        allow update: if canManageTournament(tournamentId)
          || (signedIn()
            && resource.data.coachUid == request.auth.uid
            && request.resource.data.coachUid == request.auth.uid
            && request.resource.data.status == 'pending');
        allow delete: if canManageTournament(tournamentId);
      }

      // Los partidos pertenecen al torneo y los gestiona su administrador.
      match /matches/{matchId} {
        allow read: if canManageTournament(tournamentId)
          || (signedIn() && resource.data.participantIds.hasAny([request.auth.uid]))
          || (signedIn() && (resource.data.refereeId == request.auth.uid
            || resource.data.refereeOne == request.auth.uid
            || resource.data.refereeTwo == request.auth.uid));
        allow create: if canManageTournament(tournamentId)
          || (signedIn() && request.resource.data.refereeId == request.auth.uid);
        allow update: if canManageTournament(tournamentId)
          || (signedIn() && resource.data.refereeId == request.auth.uid);
        allow delete: if canManageTournament(tournamentId);
      }
    }

    // Permite el calendario global basado en collectionGroup('matches').
    // Las pantallas por torneo mantienen las validaciones específicas anteriores.
    match /{path=**}/matches/{matchId} {
      allow read: if true;
    }

    // Permite resolver nombres y colores de equipos inscritos en el calendario.
    match /{path=**}/registrations/{registrationId} {
      allow read: if resource.data.status == 'approved' || signedIn();
    }

    // Mantiene compatibilidad con la colección raíz creada en Firebase Console.
    match /teams/{teamId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
